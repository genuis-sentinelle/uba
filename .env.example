# =============================================================================
# ARCHIVA UBA — VARIABLES D'ENVIRONNEMENT (SUPABASE & VERCEL)
# =============================================================================

# 1. Configuration Client Navigateur (Exposée publiquement)
# URL de votre projet Supabase (ex: https://votre-projet.supabase.co)
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé API publique (Publishable / Anon) de votre projet Supabase
VITE_SUPABASE_ANON_KEY=votre_cle_anon_ou_publishable

# 2. Configuration Serveur Uniquement (CONFIDENTIEL - JAMAIS AVEC PRÉFIXE VITE_)
# Clé secrète de service Supabase pour les fonctions Vercel /api et scripts d'administration
# ATTENTION : Ne JAMAIS committer cette clé, ne JAMAIS la préfixer par VITE_
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete

# URL du projet de Production (utilisée pour bloquer automatiquement l'accès en Preview si la séparation n'est pas faite)
SUPABASE_PROD_URL=https://votre-projet-prod.supabase.co

# Pour autoriser exceptionnellement l'exécution en preview si une base dédiée n'est pas encore provisionnée (défaut : false)
# ALLOW_PREVIEW_WITH_PROD_DB=false

# 3. URL de Redirection & Domaines Autorisés
ALLOWED_ORIGINS=http://localhost:5173,https://archiva-uba.vercel.app
